[Unit]
Description=OpenRhiza Nexus
After=network.target

[Service]
Type=simple
User=openrhiza
Group=openrhiza
WorkingDirectory=/opt/openrhiza/openrhiza-nexus
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
