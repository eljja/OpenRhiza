const CAP_MMIO: u32 = 0x02;
const CAP_DMA: u32 = 0x08;
const CAP_IRQ: u32 = 0x10;
const VIRTIO_MAGIC: u32 = 0x7472_6976;
const VIRTIO_MMIO_BASE: u32 = 0x0a00_0000;
const VIRTIO_MMIO_STRIDE: u32 = 0x200;
const VIRTIO_MMIO_COUNT: usize = 32;
const VIRTQ_QUEUE_SIZE: u32 = 8;
const VIRTQ_DESC_OFFSET: u32 = 0x000;
const VIRTQ_AVAIL_OFFSET: u32 = 0x100;
const VIRTQ_USED_OFFSET: u32 = 0x200;
const VIRTQ_PAYLOAD_OFFSET: u32 = 0x300;
const VIRTQ_MODERN_QUEUE_SPAN: u32 = 0x1000;
const VIRTQ_LEGACY_AVAIL_OFFSET: u32 = 0x080;
const VIRTQ_LEGACY_USED_OFFSET: u32 = 0x1000;
const VIRTQ_LEGACY_PAYLOAD_OFFSET: u32 = 0x2000;
const VIRTQ_LEGACY_QUEUE_SPAN: u32 = 0x4000;
const REG_DEVICE_FEATURES: u32 = 0x010;
const REG_DEVICE_FEATURES_SEL: u32 = 0x014;
const REG_DRIVER_FEATURES: u32 = 0x020;
const REG_DRIVER_FEATURES_SEL: u32 = 0x024;
const REG_QUEUE_SEL: u32 = 0x030;
const REG_QUEUE_NUM: u32 = 0x038;
const REG_GUEST_PAGE_SIZE: u32 = 0x028;
const REG_QUEUE_PFN: u32 = 0x040;
const REG_QUEUE_READY: u32 = 0x044;
const REG_QUEUE_NOTIFY: u32 = 0x050;
const REG_INTERRUPT_STATUS: u32 = 0x060;
const REG_INTERRUPT_ACK: u32 = 0x064;
const REG_STATUS: u32 = 0x070;
const REG_QUEUE_DESC_LOW: u32 = 0x080;
const REG_QUEUE_DESC_HIGH: u32 = 0x084;
const REG_QUEUE_DRIVER_LOW: u32 = 0x090;
const REG_QUEUE_DRIVER_HIGH: u32 = 0x094;
const REG_QUEUE_DEVICE_LOW: u32 = 0x0a0;
const REG_QUEUE_DEVICE_HIGH: u32 = 0x0a4;
const REG_CONFIG: u32 = 0x100;
const STATUS_ACKNOWLEDGE: u32 = 0x01;
const STATUS_DRIVER: u32 = 0x02;
const STATUS_DRIVER_OK: u32 = 0x04;
const STATUS_FEATURES_OK: u32 = 0x08;
const STATUS_FAILED: u32 = 0x80;
const VIRTQ_DESC_F_NEXT: u16 = 0x01;
const VIRTQ_DESC_F_WRITE: u16 = 0x02;
const VIRTIO_COMPLETION_USED_RING: u32 = 0x8000_0000;
const VIRTIO_BLK_F_RO: u32 = 1 << 5;
const VIRTIO_BLK_T_IN: u32 = 0;
const VIRTIO_BLK_T_OUT: u32 = 1;
const VIRTIO_BLK_SCRATCH_LBA: u64 = 4096;
const VIRTIO_GPU_CMD_GET_DISPLAY_INFO: u32 = 0x0100;
const VIRTQ_POLL_DEVICE: u32 = 50_000_000;
const NORMAL_WORK_BLOCK_READ: u32 = 0;
const NORMAL_WORK_BLOCK_WRITE: u32 = 1;
const NORMAL_WORK_GPU_CONTROL: u32 = 2;
const NORMAL_WORK_NET_RX: u32 = 3;
const NORMAL_WORK_NET_TX: u32 = 4;

#[panic_handler]
fn panic(_info: &PanicInfo) -> ! {
    loop {}
}

fn log(bytes: &[u8]) {
    unsafe { os_log(bytes.as_ptr(), bytes.len() as u32) }
}

fn log_hex(prefix: &[u8], value: u32) {
    let mut buf = [0u8; 96];
    let mut pos = 0usize;
    for &byte in prefix {
        if pos < buf.len() {
            buf[pos] = byte;
            pos += 1;
        }
    }
    let hex = *b"0123456789abcdef";
    if pos + 11 < buf.len() {
        buf[pos] = b'0';
        buf[pos + 1] = b'x';
        pos += 2;
        let mut shift = 28i32;
        while shift >= 0 {
            buf[pos] = hex[((value >> shift) & 0x0f) as usize];
            pos += 1;
            shift -= 4;
        }
        buf[pos] = b'\n';
        pos += 1;
    }
    log(&buf[..pos]);
}

fn build_match_key(index: usize, out: &mut [u8; 24]) -> usize {
    let prefix = b"virtio-mmio:0x";
    let mut pos = 0usize;
    while pos < prefix.len() {
        out[pos] = prefix[pos];
        pos += 1;
    }

    let value = VIRTIO_MMIO_BASE.wrapping_add((index as u32).wrapping_mul(VIRTIO_MMIO_STRIDE));
    let hex = *b"0123456789abcdef";
    let mut shift = 28i32;
    while shift >= 0 {
        out[pos] = hex[((value >> shift) & 0x0f) as usize];
        pos += 1;
        shift -= 4;
    }
    pos
}

fn log_label(prefix: &[u8], label: &[u8]) {
    log(prefix);
    log(label);
    log(b"\n");
}

fn write_u16(buf: &mut [u8], offset: usize, value: u16) {
    buf[offset] = value as u8;
    buf[offset + 1] = (value >> 8) as u8;
}

fn read_u16(buf: &[u8], offset: usize) -> u16 {
    (buf[offset] as u16) | ((buf[offset + 1] as u16) << 8)
}

fn read_u32(buf: &[u8], offset: usize) -> u32 {
    (buf[offset] as u32)
        | ((buf[offset + 1] as u32) << 8)
        | ((buf[offset + 2] as u32) << 16)
        | ((buf[offset + 3] as u32) << 24)
}

fn write_u32(buf: &mut [u8], offset: usize, value: u32) {
    buf[offset] = value as u8;
    buf[offset + 1] = (value >> 8) as u8;
    buf[offset + 2] = (value >> 16) as u8;
    buf[offset + 3] = (value >> 24) as u8;
}

fn write_u64(buf: &mut [u8], offset: usize, value: u64) {
    let mut shift = 0usize;
    while shift < 8 {
        buf[offset + shift] = (value >> (shift * 8)) as u8;
        shift += 1;
    }
}

struct PayloadPlan {
    used_offset: u32,
    payload_offset: u32,
    role: &'static [u8],
    previous_used_idx: u16,
}

struct QueueLayout {
    queue_span: u32,
    desc_offset: u32,
    avail_offset: u32,
    used_offset: u32,
    payload_offset: u32,
}

fn queue_layout(version: u32) -> QueueLayout {
    if version >= 2 {
        QueueLayout {
            queue_span: VIRTQ_MODERN_QUEUE_SPAN,
            desc_offset: VIRTQ_DESC_OFFSET,
            avail_offset: VIRTQ_AVAIL_OFFSET,
            used_offset: VIRTQ_USED_OFFSET,
            payload_offset: VIRTQ_PAYLOAD_OFFSET,
        }
    } else {
        QueueLayout {
            queue_span: VIRTQ_LEGACY_QUEUE_SPAN,
            desc_offset: VIRTQ_DESC_OFFSET,
            avail_offset: VIRTQ_LEGACY_AVAIL_OFFSET,
            used_offset: VIRTQ_LEGACY_USED_OFFSET,
            payload_offset: VIRTQ_LEGACY_PAYLOAD_OFFSET,
        }
    }
}

fn write_desc(
    desc: &mut [u8; 128],
    index: usize,
    addr: u64,
    len: u32,
    flags: u16,
    next: u16,
) {
    let base = index * 16;
    write_u64(desc, base, addr);
    write_u32(desc, base + 8, len);
    write_u16(desc, base + 12, flags);
    write_u16(desc, base + 14, next);
}

fn write_avail(avail: &mut [u8; 24], head: u16) {
    write_u16(avail, 0, 0);
    write_u16(avail, 2, 1);
    write_u16(avail, 4, head);
}

fn zero_queue_memory(handle: u32, dma: u32, desc_offset: u32, avail_offset: u32, used_offset: u32) -> bool {
    let zero128 = [0u8; 128];
    let zero24 = [0u8; 24];
    let w0 = unsafe {
        os_driver_dma_write(handle, dma, desc_offset, zero128.as_ptr(), zero128.len() as u32)
    };
    let w1 = unsafe {
        os_driver_dma_write(handle, dma, avail_offset, zero24.as_ptr(), zero24.len() as u32)
    };
    let w2 = unsafe {
        os_driver_dma_write(handle, dma, used_offset, zero24.as_ptr(), zero24.len() as u32)
    };
    w0 == zero128.len() as u32 && w1 == zero24.len() as u32 && w2 == zero24.len() as u32
}

fn build_net_rx_layout(desc: &mut [u8; 128], payload_phys: u64) -> u32 {
    write_desc(desc, 0, payload_phys, 2048, VIRTQ_DESC_F_WRITE, 0);
    0
}

fn build_net_tx_layout(desc: &mut [u8; 128], payload: &mut [u8; 768], payload_phys: u64) -> u32 {
    let frame = b"OpenRhiza virtio-net sandbox TX payload";
    let mut pos = 0usize;
    while pos < 12 {
        payload[pos] = 0;
        pos += 1;
    }
    let dst = [0xffu8; 6];
    let src = [0x52u8, 0x54, 0x00, 0x12, 0x34, 0x56];
    let mut i = 0usize;
    while i < 6 {
        payload[pos + i] = dst[i];
        payload[pos + 6 + i] = src[i];
        i += 1;
    }
    pos += 12;
    payload[pos] = 0x88;
    payload[pos + 1] = 0xb5;
    pos += 2;
    i = 0;
    while i < frame.len() {
        payload[pos + i] = frame[i];
        i += 1;
    }
    let payload_len = (pos + frame.len()).max(60);
    write_desc(desc, 0, payload_phys, payload_len as u32, 0, 0);
    payload_len as u32
}

fn build_block_read_layout(desc: &mut [u8; 128], payload: &mut [u8; 768], payload_phys: u64) -> u32 {
    let req_phys = payload_phys;
    let data_phys = payload_phys + 64;
    let status_phys = payload_phys + 576;
    write_u32(payload, 0, VIRTIO_BLK_T_IN);
    write_u32(payload, 4, 0);
    write_u64(payload, 8, 0);
    payload[576] = 0xff;
    write_desc(desc, 0, req_phys, 16, VIRTQ_DESC_F_NEXT, 1);
    write_desc(desc, 1, data_phys, 512, VIRTQ_DESC_F_NEXT | VIRTQ_DESC_F_WRITE, 2);
    write_desc(desc, 2, status_phys, 1, VIRTQ_DESC_F_WRITE, 0);
    577
}

fn build_block_write_layout(desc: &mut [u8; 128], payload: &mut [u8; 768], payload_phys: u64) -> u32 {
    let req_phys = payload_phys;
    let data_phys = payload_phys + 64;
    let status_phys = payload_phys + 576;
    write_u32(payload, 0, VIRTIO_BLK_T_OUT);
    write_u32(payload, 4, 0);
    write_u64(payload, 8, VIRTIO_BLK_SCRATCH_LBA);
    let msg = b"OpenRhiza virtio-block sandbox write verification sector. This sector must be on a scratch test image.";
    let mut i = 0usize;
    while i < 512 {
        payload[64 + i] = if i < msg.len() { msg[i] } else { (i as u8).wrapping_mul(17) };
        i += 1;
    }
    payload[576] = 0xff;
    write_desc(desc, 0, req_phys, 16, VIRTQ_DESC_F_NEXT, 1);
    write_desc(desc, 1, data_phys, 512, VIRTQ_DESC_F_NEXT, 2);
    write_desc(desc, 2, status_phys, 1, VIRTQ_DESC_F_WRITE, 0);
    577
}

fn build_input_event_layout(desc: &mut [u8; 128], payload_phys: u64) -> u32 {
    write_desc(desc, 0, payload_phys, 8, VIRTQ_DESC_F_WRITE, 0);
    8
}

fn build_gpu_control_layout(desc: &mut [u8; 128], payload: &mut [u8; 768], payload_phys: u64) -> u32 {
    let req_phys = payload_phys;
    let resp_phys = payload_phys + 64;
    write_u32(payload, 0, VIRTIO_GPU_CMD_GET_DISPLAY_INFO);
    write_u32(payload, 4, 0);
    write_u64(payload, 8, 0);
    write_u32(payload, 16, 0);
    write_u32(payload, 20, 0);
    write_desc(desc, 0, req_phys, 24, VIRTQ_DESC_F_NEXT, 1);
    write_desc(desc, 1, resp_phys, 512, VIRTQ_DESC_F_WRITE, 0);
    576
}

fn build_payload_layout(
    handle: u32,
    dma: u32,
    dma_phys: u32,
    queue_index: u32,
    role: &[u8],
    device_features: u32,
    version: u32,
) -> Option<PayloadPlan> {
    let layout = queue_layout(version);
    let queue_span = queue_index.saturating_mul(layout.queue_span);
    let desc_offset = queue_span + layout.desc_offset;
    let avail_offset = queue_span + layout.avail_offset;
    let used_offset = queue_span + layout.used_offset;
    let payload_offset = queue_span + layout.payload_offset;

    let payload_phys = dma_phys as u64 + payload_offset as u64;
    if !zero_queue_memory(handle, dma, desc_offset, avail_offset, used_offset) {
        return None;
    }

    let mut desc = [0u8; 128];
    let mut avail = [0u8; 24];
    let mut payload = [0u8; 768];
    let payload_len = if TARGET_DEVICE_ID == 1 && role == b"rx" {
        build_net_rx_layout(&mut desc, payload_phys)
    } else if TARGET_DEVICE_ID == 1 && role == b"tx" {
        build_net_tx_layout(&mut desc, &mut payload, payload_phys)
    } else if TARGET_DEVICE_ID == 2 && role == b"read" {
        build_block_read_layout(&mut desc, &mut payload, payload_phys)
    } else if TARGET_DEVICE_ID == 2 && role == b"write" {
        if device_features & VIRTIO_BLK_F_RO != 0 {
            log(b"[Skill][virtio] block write denied: device is read-only.\n");
            return None;
        }
        let capacity_low = unsafe { os_driver_mmio_read32(handle, REG_CONFIG) };
        let capacity_high = unsafe { os_driver_mmio_read32(handle, REG_CONFIG + 4) };
        let capacity = (capacity_low as u64) | ((capacity_high as u64) << 32);
        log_hex(b"[Skill][virtio] block_capacity_low=", capacity_low);
        log_hex(b"[Skill][virtio] block_capacity_high=", capacity_high);
        if capacity <= VIRTIO_BLK_SCRATCH_LBA + 1 {
            log(b"[Skill][virtio] block write denied: no scratch LBA capacity.\n");
            return None;
        }
        build_block_write_layout(&mut desc, &mut payload, payload_phys)
    } else if TARGET_DEVICE_ID == 18 {
        build_input_event_layout(&mut desc, payload_phys)
    } else if TARGET_DEVICE_ID == 16 {
        build_gpu_control_layout(&mut desc, &mut payload, payload_phys)
    } else {
        return None;
    };

    write_avail(&mut avail, 0);

    let w0 = unsafe {
        os_driver_dma_write(handle, dma, desc_offset, desc.as_ptr(), desc.len() as u32)
    };
    let w1 = unsafe {
        os_driver_dma_write(handle, dma, avail_offset, avail.as_ptr(), avail.len() as u32)
    };
    let w2 = unsafe {
        os_driver_dma_write(handle, dma, payload_offset, payload.as_ptr(), payload_len)
    };
    if w0 != desc.len() as u32
        || w1 != avail.len() as u32
        || w2 != payload_len
    {
        return None;
    }

    let mut check = [0u8; 32];
    let copied = unsafe {
        os_driver_dma_read(handle, dma, desc_offset, check.as_mut_ptr(), check.len() as u32)
    };
    if copied == check.len() as u32
        && check[0] == desc[0]
        && read_u32(&check, 8) != 0
        && check[12] == desc[12]
    {
        Some(PayloadPlan {
            used_offset,
            payload_offset,
            role: if TARGET_DEVICE_ID == 1 && role == b"rx" {
                b"net-rx"
            } else if TARGET_DEVICE_ID == 1 && role == b"tx" {
                b"net-tx"
            } else if TARGET_DEVICE_ID == 2 && role == b"read" {
                b"block-read"
            } else if TARGET_DEVICE_ID == 2 && role == b"write" {
                b"block-write"
            } else if TARGET_DEVICE_ID == 18 {
                b"input-event"
            } else if TARGET_DEVICE_ID == 16 {
                b"gpu-control"
            } else {
                b"unknown"
            },
            previous_used_idx: 0,
        })
    } else {
        None
    }
}

fn negotiate_features(handle: u32, gate: u32) -> bool {
    let _ = unsafe { os_driver_mmio_write32(handle, REG_STATUS, 0) };
    let _ = unsafe {
        os_driver_mmio_write32(handle, REG_STATUS, STATUS_ACKNOWLEDGE | STATUS_DRIVER)
    };
    let _ = unsafe { os_driver_mmio_write32(handle, REG_DEVICE_FEATURES_SEL, 0) };
    let device_features = unsafe { os_driver_mmio_read32(handle, REG_DEVICE_FEATURES) };
    let driver_features = DRIVER_FEATURES_LOW & device_features;
    let _ = unsafe { os_driver_mmio_write32(handle, REG_DRIVER_FEATURES_SEL, 0) };
    let _ = unsafe { os_driver_mmio_write32(handle, REG_DRIVER_FEATURES, driver_features) };
    let _ = unsafe {
        os_driver_mmio_write32(
            handle,
            REG_STATUS,
            STATUS_ACKNOWLEDGE | STATUS_DRIVER | STATUS_FEATURES_OK,
        )
    };
    let status = unsafe { os_driver_mmio_read32(handle, REG_STATUS) };
    log_hex(b"[Skill][virtio] negotiated_features=", driver_features);
    log_hex(b"[Skill][virtio] feature_status=", status);
    let recorded =
        unsafe { os_virtio_record_feature_negotiation(gate, device_features, driver_features, status) };
    recorded != 0 && status & STATUS_FEATURES_OK != 0 && status & STATUS_FAILED == 0
}

fn program_queue(
    handle: u32,
    gate: u32,
    dma_phys: u32,
    queue_index: u32,
    queue_size: u32,
    version: u32,
) -> bool {
    let layout = queue_layout(version);
    let queue_span = queue_index.saturating_mul(layout.queue_span);
    let desc_phys = dma_phys.saturating_add(queue_span + layout.desc_offset);
    let driver_phys = dma_phys.saturating_add(queue_span + layout.avail_offset);
    let device_phys = dma_phys.saturating_add(queue_span + layout.used_offset);

    let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_SEL, queue_index) };
    let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_NUM, queue_size) };
    if version >= 2 {
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_DESC_LOW, desc_phys) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_DESC_HIGH, 0) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_DRIVER_LOW, driver_phys) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_DRIVER_HIGH, 0) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_DEVICE_LOW, device_phys) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_DEVICE_HIGH, 0) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_READY, 1) };
    } else {
        let _ = unsafe { os_driver_mmio_write32(handle, REG_GUEST_PAGE_SIZE, 4096) };
        let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_PFN, desc_phys >> 12) };
    }

    let recorded = unsafe {
        os_virtio_record_queue_programming(
            gate,
            queue_index,
            queue_size,
            desc_phys,
            driver_phys,
            device_phys,
        )
    };
    log_hex(b"[Skill][virtio] queue_programmed=", recorded);
    recorded != 0
}

fn read_used_idx(handle: u32, dma: u32, used_offset: u32) -> Option<u16> {
    let mut used = [0u8; 4];
    let copied = unsafe {
        os_driver_dma_read(handle, dma, used_offset, used.as_mut_ptr(), used.len() as u32)
    };
    if copied == used.len() as u32 {
        Some(read_u16(&used, 2))
    } else {
        None
    }
}

fn poll_used_completion(handle: u32, dma: u32, used_offset: u32, previous_idx: u16) -> bool {
    let completed = unsafe {
        os_driver_wait_used_idx(
            handle,
            dma,
            used_offset,
            previous_idx as u32,
            VIRTQ_POLL_DEVICE,
        )
    };
    completed != 0
}

fn verify_payload_completion(handle: u32, dma: u32, plan: &PayloadPlan) -> bool {
    if plan.role == b"net-rx" {
        let mut packet = [0u8; 64];
        let copied = unsafe {
            os_driver_dma_read(handle, dma, plan.payload_offset, packet.as_mut_ptr(), packet.len() as u32)
        };
        log_hex(b"[Skill][virtio] net_rx_bytes_read=", copied);
        copied == packet.len() as u32
    } else if plan.role == b"net-tx" {
        log(b"[Skill][virtio] net TX descriptor completed by device.\n");
        true
    } else if plan.role == b"block-read" {
        let mut status = [0u8; 1];
        let copied = unsafe {
            os_driver_dma_read(handle, dma, plan.payload_offset + 576, status.as_mut_ptr(), 1)
        };
        log_hex(b"[Skill][virtio] block_read_status=", if copied == 1 { status[0] as u32 } else { 0xff });
        copied == 1 && status[0] == 0
    } else if plan.role == b"block-write" {
        let mut status = [0u8; 1];
        let copied = unsafe {
            os_driver_dma_read(handle, dma, plan.payload_offset + 576, status.as_mut_ptr(), 1)
        };
        log_hex(b"[Skill][virtio] block_write_status=", if copied == 1 { status[0] as u32 } else { 0xff });
        copied == 1 && status[0] == 0
    } else if plan.role == b"input-event" {
        let mut event = [0u8; 8];
        let copied = unsafe {
            os_driver_dma_read(handle, dma, plan.payload_offset, event.as_mut_ptr(), event.len() as u32)
        };
        let event_type = if copied == event.len() as u32 { read_u16(&event, 0) as u32 } else { 0xffff };
        let event_code = if copied == event.len() as u32 { read_u16(&event, 2) as u32 } else { 0xffff };
        let event_value = if copied == event.len() as u32 { read_u32(&event, 4) } else { 0xffff_ffff };
        log_hex(b"[Skill][virtio] input_event_type=", event_type);
        log_hex(b"[Skill][virtio] input_event_code=", event_code);
        log_hex(b"[Skill][virtio] input_event_value=", event_value);
        copied == event.len() as u32
    } else if plan.role == b"gpu-control" {
        let mut response = [0u8; 16];
        let copied = unsafe {
            os_driver_dma_read(handle, dma, plan.payload_offset + 64, response.as_mut_ptr(), response.len() as u32)
        };
        let response_type = if copied == response.len() as u32 { read_u32(&response, 0) } else { 0 };
        log_hex(b"[Skill][virtio] gpu_response_type=", response_type);
        copied == response.len() as u32 && response_type != 0
    } else {
        false
    }
}

fn notify_and_complete_payload(handle: u32, gate: u32, dma: u32, queue_index: u32, plan: &PayloadPlan) -> bool {
    let _ = unsafe {
        os_driver_mmio_write32(
            handle,
            REG_STATUS,
            STATUS_ACKNOWLEDGE | STATUS_DRIVER | STATUS_DRIVER_OK | STATUS_FEATURES_OK,
        )
    };
    let _ = unsafe { os_driver_dma_barrier(handle, dma) };
    let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_NOTIFY, queue_index) };
    let notify_ok = unsafe { os_virtio_record_queue_notify(gate, queue_index) };
    let used_complete = poll_used_completion(handle, dma, plan.used_offset, plan.previous_used_idx);
    let irq_status = unsafe { os_driver_mmio_read32(handle, REG_INTERRUPT_STATUS) };
    let completion_status = if irq_status != 0 {
        let _ = unsafe { os_driver_mmio_write32(handle, REG_INTERRUPT_ACK, irq_status) };
        let _ = unsafe { os_driver_irq_ack(handle, irq_status) };
        irq_status
    } else if used_complete {
        VIRTIO_COMPLETION_USED_RING
    } else {
        0
    };
    let response_ok = if completion_status != 0 {
        verify_payload_completion(handle, dma, plan)
    } else {
        false
    };
    let irq_ok = if completion_status != 0 && response_ok {
        unsafe { os_virtio_record_irq_completion(gate, completion_status, completion_status) }
    } else {
        0
    };
    log_hex(b"[Skill][virtio] queue_notify=", notify_ok);
    log_hex(b"[Skill][virtio] used_complete=", if used_complete { 1 } else { 0 });
    log_hex(b"[Skill][virtio] irq_status=", irq_status);
    log_hex(b"[Skill][virtio] response_ok=", if response_ok { 1 } else { 0 });
    log_hex(b"[Skill][virtio] irq_complete=", irq_ok);
    notify_ok != 0 && irq_ok != 0 && submit_normal_work_from_payload(plan) != 0
}

fn submit_normal_work_from_payload(plan: &PayloadPlan) -> u32 {
    let (kind, a, b, c) = if plan.role == b"net-rx" {
        (NORMAL_WORK_NET_RX, 1, 1514, 0)
    } else if plan.role == b"net-tx" {
        (NORMAL_WORK_NET_TX, 1, 64, 0)
    } else if plan.role == b"block-read" {
        (NORMAL_WORK_BLOCK_READ, 0, 1, 0)
    } else if plan.role == b"block-write" {
        (NORMAL_WORK_BLOCK_WRITE, VIRTIO_BLK_SCRATCH_LBA as u32, 1, 1)
    } else if plan.role == b"gpu-control" {
        (NORMAL_WORK_GPU_CONTROL, 1920, 1080, 1)
    } else {
        return 1;
    };
    let submitted = unsafe { os_arm64_submit_normal_work(kind, a, b, c) };
    log_hex(b"[Skill][virtio] normal_work_submit=", submitted);
    submitted
}

fn reset_device(handle: u32) {
    let _ = unsafe { os_driver_mmio_write32(handle, REG_QUEUE_SEL, 0) };
    let _ = unsafe { os_driver_mmio_write32(handle, REG_STATUS, 0) };
}

#[no_mangle]
pub extern "C" fn init_driver() {
    log_label(b"[Skill] sandbox virtio-mmio driver candidate initialized: ", LABEL);
}

#[no_mangle]
pub extern "C" fn run_skill() -> i32 {
    let mut matched = false;
    let mut ready = false;
    let mut index = 0usize;
    while index < VIRTIO_MMIO_COUNT {
        let mut key_buf = [0u8; 24];
        let key_len = build_match_key(index, &mut key_buf);
        let handle = unsafe {
            os_driver_claim_mmio_device(
                key_buf.as_ptr(),
                key_len as u32,
                DRIVER_ID.as_ptr(),
                DRIVER_ID.len() as u32,
                CAP_MMIO | CAP_DMA | CAP_IRQ,
            )
        };
        if handle == 0 {
            index += 1;
            continue;
        }

        let _ = unsafe { os_driver_handle_heartbeat(handle) };
        let magic = unsafe { os_driver_mmio_read32(handle, 0x000) };
        let version = unsafe { os_driver_mmio_read32(handle, 0x004) };
        let device_id = unsafe { os_driver_mmio_read32(handle, 0x008) };
        let vendor_id = unsafe { os_driver_mmio_read32(handle, 0x00c) };
        let features = unsafe { os_driver_mmio_read32(handle, 0x010) };
        let queue_num_max = unsafe { os_driver_mmio_read32(handle, 0x034) };
        let status = unsafe { os_driver_mmio_read32(handle, 0x070) };
        if magic == VIRTIO_MAGIC && version >= 1 && device_id == TARGET_DEVICE_ID {
            matched = true;
            log_label(b"[Skill][virtio] matched sandbox candidate: ", LABEL);
            log_hex(b"[Skill][virtio] handle=", handle);
            log_hex(b"[Skill][virtio] device_id=", device_id);
            log_hex(b"[Skill][virtio] vendor_id=", vendor_id);
            log_hex(b"[Skill][virtio] features_low=", features);
            log_hex(b"[Skill][virtio] queue_num_max=", queue_num_max);
            log_hex(b"[Skill][virtio] status=", status);
            log_hex(b"[Skill][virtio] irq_line=", unsafe { os_driver_irq_poll(handle) });
            let dma = unsafe { os_driver_dma_alloc(handle, 32768, 4096) };
            log_hex(b"[Skill][virtio] dma_handle=", dma);
            if dma != 0 {
                let dma_phys = unsafe { os_driver_dma_phys(handle, dma) };
                log_hex(b"[Skill][virtio] dma_phys=", dma_phys);
                let mut plan_index = 0usize;
                let mut plan_ready = QUEUE_PLAN.len() > 0;
                while plan_index < QUEUE_PLAN.len() {
                    let (queue_index, role) = QUEUE_PLAN[plan_index];
                    log_hex(b"[Skill][virtio] executor_queue=", queue_index);
                    log_label(b"[Skill][virtio] executor_role=", role);
                    let payload_plan =
                        build_payload_layout(handle, dma, dma_phys, queue_index, role, features, version);
                    log_hex(b"[Skill][virtio] payload_layout_ok=", if payload_plan.is_some() { 1 } else { 0 });
                    let Some(payload_plan) = payload_plan else {
                        plan_ready = false;
                        plan_index += 1;
                        continue;
                    };
                    let gate = unsafe {
                        os_virtio_prepare_live_gate(
                            handle,
                            TARGET_DEVICE_ID,
                            queue_index,
                            dma,
                            VIRTQ_QUEUE_SIZE,
                        )
                    };
                    log_hex(b"[Skill][virtio] live_gate=", gate);
                    if gate == 0 {
                        plan_ready = false;
                    } else {
                        let features_ok = negotiate_features(handle, gate);
                        log_hex(b"[Skill][virtio] features_ok=", if features_ok { 1 } else { 0 });
                        let queue_ok =
                            program_queue(handle, gate, dma_phys, queue_index, VIRTQ_QUEUE_SIZE, version);
                        let io_ok =
                            notify_and_complete_payload(handle, gate, dma, queue_index, &payload_plan);
                        let commit = unsafe { os_virtio_commit_live_gate(gate) };
                        log_hex(b"[Skill][virtio] live_commit=", commit);
                        let rollback = unsafe { os_virtio_rollback_live_gate(gate) };
                        log_hex(b"[Skill][virtio] live_rollback=", rollback);
                        reset_device(handle);
                        if !features_ok || !queue_ok || !io_ok || commit == 0 || rollback == 0 {
                            plan_ready = false;
                        }
                    }
                    plan_index += 1;
                }
                ready = ready || plan_ready;
                log(b"[Skill][virtio] device payload submission proof finished; live commit requires real used-ring or IRQ evidence.\n");
            } else {
                log(b"[Skill][virtio] DMA queue-memory proof failed; candidate must not be promoted.\n");
            }
        }
        if device_id == TARGET_DEVICE_ID {
            reset_device(handle);
        }
        let released = unsafe { os_driver_release_device(handle) };
        if device_id == TARGET_DEVICE_ID {
            log_hex(b"[Skill][virtio] release=", released);
        }
        index += 1;
    }

    if ready {
        log(b"[Skill][virtio] executor candidate passed with real payload completion evidence.\n");
        1
    } else if matched {
        log(b"[Skill][virtio] matching transport found but candidate proof is incomplete.\n");
        0
    } else {
        log_label(b"[Skill][virtio] no matching active transport for ", LABEL);
        0
    }
}
